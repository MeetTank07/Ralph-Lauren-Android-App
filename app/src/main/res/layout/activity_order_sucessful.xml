<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Order_sucessful">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#F8F9FB">

        <!-- Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Success Icon -->
                <ImageView
                    android:id="@+id/imgSuccess"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="24dp"
                    android:padding="20dp"
                    android:background="@drawable/oder"
                    />

                <!-- Title -->
                <TextView
                    android:id="@+id/txtOrderSuccess"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Successful 🎉"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2C2C2C"
                    android:layout_marginBottom="10dp"/>

                <!-- Subtitle -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your order has been placed successfully."
                    android:textSize="16sp"
                    android:textColor="#777777"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- Payment Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please pay when the delivery agent arrives."
                    android:textSize="15sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Button -->
                <Button
                    android:id="@+id/btnContinue"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Continue Shopping"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>



